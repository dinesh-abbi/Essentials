<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark-mode widget palette — mirrors src/app/(tabs)/index.tsx `colors` for
  isDark, so the widget matches the app's own dark theme exactly.
-->
<resources>
    <color name="widget_text">#F0F0EB</color>
    <color name="widget_text_secondary">#888888</color>
    <color name="widget_primary">#60A5FA</color>
    <color name="widget_track">#1460A5FA</color>
    <!-- quick-log chip fill: primary @ 16% -->
    <color name="widget_chip_fill">#2960A5FA</color>
    <!-- tap ripple: light @ 20%, since the widget sits on an arbitrary wallpaper -->
    <color name="widget_ripple">#33FFFFFF</color>
</resources>
