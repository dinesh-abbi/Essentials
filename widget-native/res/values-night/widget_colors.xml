<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark-mode widget palette — mirrors src/app/(tabs)/index.tsx `colors` for
  isDark, so the widget matches the app's own dark theme exactly.
-->
<resources>
    <color name="widget_text">#EFF4F1</color>
    <color name="widget_text_secondary">#9DB3AA</color>
    <color name="widget_primary">#7FB8A4</color>
    <color name="widget_track">#147FB8A4</color>
    <!-- quick-log chip fill: primary @ 14% -->
    <color name="widget_chip_fill">#247FB8A4</color>
    <!-- tap ripple: light @ 20%, since the widget sits on an arbitrary wallpaper -->
    <color name="widget_ripple">#33FFFFFF</color>
</resources>
