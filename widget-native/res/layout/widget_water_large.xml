<?xml version="1.0" encoding="utf-8"?>
<!--
  Large card — shown once the user resizes the widget past roughly 4x2.
  Adds the detail a bigger footprint has room for: percent-of-goal, a
  logs-today count, and three quick-log amounts instead of just one.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ripple_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2.5"
                android:text="HYDRATION" />

            <ImageView
                android:id="@+id/iv_time"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Numbers + capsule -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_text"
                    android:textSize="30sp"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="0 ml" />

                <TextView
                    android:id="@+id/tv_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="13sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2.5"
                    android:text="of 3,000 ml today" />

                <TextView
                    android:id="@+id/tv_logs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2.5"
                    android:text="0 logs today" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_ring"
                android:layout_width="40dp"
                android:layout_height="66dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/widget_water_description" />
        </LinearLayout>

        <!-- Quick-log row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <FrameLayout
                android:id="@+id/btn_quicklog_100"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_quicklog_pill_bg">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/widget_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:text="+100" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_quicklog_250"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_quicklog_pill_bg">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/widget_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:text="+250" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_quicklog_500"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:background="@drawable/widget_quicklog_pill_bg">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/widget_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:text="+500" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
