<?xml version="1.0" encoding="utf-8"?>
<!--
  The "glass" card. Kept as a soft translucent rounded surface + hairline
  border rather than a fake heavy blur — matches how app-tabs.tsx fakes
  glass elsewhere in this app (semi-transparent rgba surface, not a real
  blur layer), so it stays consistent instead of trying to out-glass the app.
  On launchers that already blur widget backgrounds (Android 12+ Pixel-style),
  this translucency lets that system blur read through naturally.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/widget_border" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
