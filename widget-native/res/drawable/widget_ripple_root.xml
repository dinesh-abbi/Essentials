<?xml version="1.0" encoding="utf-8"?>
<!--
  Tap feedback for the widget's root click target. Transparent at rest —
  this is NOT the old card background, it only paints while pressed — which
  is how a widget stays edgeless yet still feels responsive to a tap.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</ripple>
